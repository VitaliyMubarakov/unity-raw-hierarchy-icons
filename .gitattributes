# Normalise line endings so contributors on different systems do not produce
# whole-file diffs. Files Unity rewrites itself are pinned to LF, which is what
# Unity writes on every platform - otherwise it would undo a CRLF checkout and
# leave the file permanently dirty.

* text=auto

*.cs      text diff=csharp
*.md      text
*.json    text eol=lf
*.asmdef  text eol=lf
*.meta    text eol=lf
